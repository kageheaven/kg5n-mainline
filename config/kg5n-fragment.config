# Enable Unisoc UMS9230 (Tiger T606) platform + drivers for Tecno Spark 8C (KG5n)
# Merged on top of arch/arm64/configs/defconfig (which already sets CONFIG_ARCH_SPRD=y).
# Headless home-server bring-up: UART console, eMMC, PMIC, USB, Wi-Fi/BT (WCN).

CONFIG_ARCH_SPRD=y
CONFIG_SPRD_TIMER=y
CONFIG_SPRD_COMMON_CLK=y
CONFIG_SPRD_UMS9230_CLK=y

CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y

CONFIG_PINCTRL_SPRD=y
CONFIG_PINCTRL_SPRD_UMS9230=y
CONFIG_GPIO_SPRD=y
CONFIG_GPIO_EIC_SPRD=y
CONFIG_GPIO_PMIC_EIC_SPRD=y

CONFIG_SPRD_MBOX=y
CONFIG_SPRD_PM_DOMAINS=y
CONFIG_SPRD_IOMMU=y
CONFIG_SPRD_DMA=y
CONFIG_SPRD_THERMAL=y
CONFIG_SPRD_WATCHDOG=y
CONFIG_SPRD_AGDSP=y
CONFIG_SPRD_REMOTEPROC_COMMON=y
CONFIG_SPRD_MODEM_REMOTEPROC=y
CONFIG_SPRD_PMSYS_REMOTEPROC=y
CONFIG_SPRD_WCN_REMOTEPROC=y
CONFIG_RPMSG_SPRD_SIPC=y

CONFIG_MMC_SDHCI_SPRD=y
CONFIG_MMC_SDHCI_PLTFM=y

CONFIG_MFD_SC27XX_PMIC=y
CONFIG_REGULATOR_SC2730=y
CONFIG_REGULATOR_SC2731=y
CONFIG_RTC_DRV_SC27XX=y
CONFIG_INPUT_SC27XX_VIBRA=y
CONFIG_NVMEM_SC27XX_EFUSE=y
CONFIG_NVMEM_SPRD_EFUSE=y
CONFIG_SC27XX_ADC=y
CONFIG_CHARGER_SC2731=y
CONFIG_FUEL_GAUGE_SC27XX=y
CONFIG_POWER_RESET_SC27XX=y
CONFIG_LEDS_SC27XX_BLTC=y
CONFIG_TYPEC_SC27XX_PD=y

CONFIG_I2C=y
CONFIG_I2C_SPRD=y
CONFIG_I2C_SPRD_HW_V2=y
CONFIG_SPI=y
CONFIG_SPI_SPRD=y
CONFIG_SPI_SPRD_ADI=y
CONFIG_PWM=y
CONFIG_PWM_SPRD=y

CONFIG_PHY_SPRD_USB2=y
CONFIG_USB_MUSB_SPRD=y
CONFIG_HWSPINLOCK_SPRD=y

CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_SC23XX_SIPC=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_SPRDSIPC=y

CONFIG_SND_SOC_SPRD=y
CONFIG_SND_SOC_SPRD_UMS9230=y
CONFIG_SND_SOC_SC2730=y

CONFIG_DRM_SPRD=y
